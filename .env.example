CRAYOTTER_API_KEY=
CRAYOTTER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CRAYOTTER_MODEL_NAME=qwen-plus

# Leave the dedicated video/TTS key or base URL empty to inherit the main API settings.
CRAYOTTER_VIDEO_API_KEY=
CRAYOTTER_VIDEO_BASE_URL=
CRAYOTTER_VIDEO_MODEL_NAME=qwen-vl-max-latest

CRAYOTTER_TTS_API_KEY=
CRAYOTTER_TTS_BASE_URL=
CRAYOTTER_TTS_MODEL_NAME=qwen-tts-latest

CRAYOTTER_ENABLE_PHASE2_RESEARCH=true
CRAYOTTER_ENABLE_PLAN_REVIEW=true
CRAYOTTER_DIRECT_PHASE3_EXECUTION=false
CRAYOTTER_PREFER_LOCAL_MATERIALS=false
CRAYOTTER_SEARCH_POOL_SIZE=4
CRAYOTTER_DOWNLOAD_POOL_SIZE=2
CRAYOTTER_VIDEO_ANALYSIS_POOL_SIZE=2
CRAYOTTER_LLM_POOL_SIZE=2
CRAYOTTER_FFMPEG_POOL_SIZE=2
CRAYOTTER_TTS_POOL_SIZE=2
CRAYOTTER_EXPORT_POOL_SIZE=1
CRAYOTTER_SHORT_FORM_OPTIMIZATIONS=true
CRAYOTTER_SHORT_FORM_MAX_SOURCES=2
CRAYOTTER_VIDEO_ANALYSIS_PROXY_MAX_SECONDS=45
CRAYOTTER_DOWNLOAD_MAX_HEIGHT=720
CRAYOTTER_STANDARDIZE_TARGET_FPS=30
CRAYOTTER_AUDIO_LOUDNORM_TARGET=0
CRAYOTTER_YOUTUBE_MODE=auto
CRAYOTTER_ENABLED_MATERIAL_PLATFORMS=bilibili,douyin,xiaohongshu,youtube
CRAYOTTER_DEFAULT_DEADLINE_SECONDS=600
CRAYOTTER_PROCESSING_MODE=auto
CRAYOTTER_PHASE1_MAX_SECONDS=180
CRAYOTTER_OUTPUT_PROFILE=auto
CRAYOTTER_BROWSER_AUTH_BROWSER=
CRAYOTTER_BROWSER_AUTH_PROFILE=
CRAYOTTER_POST_TASK_REVIEW_MODE=async
CRAYOTTER_AGENT_STALL_TIMEOUT_SECONDS=600
