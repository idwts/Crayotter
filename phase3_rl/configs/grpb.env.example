# Paths
VERL_DIR=/path/to/verl
MODEL_PATH=/path/to/Qwen3.5
TRAIN_FILE=/path/to/train.jsonl
VAL_FILE=/path/to/validation.jsonl
TOOL_CONFIG=/path/to/tool_config.yaml
PYTHON_BIN=python3

# Run
CONFIG_PATH=/path/to/verl/verl/trainer/config
CONFIG_NAME=ppo_trainer
PROJECT_NAME=crayotter-phase3-rl
EXPERIMENT_NAME=crayotter-grpb
REGENERATE_ASSETS=0
N_GPUS_PER_NODE=4
NNODES=1
TOTAL_TRAINING_STEPS=100
SAVE_FREQ=20
TEST_FREQ=50

# Rollout and optimization
TRAINING_STRATEGY=fsdp2
TRAIN_BATCH_SIZE=4
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE=1
ROLLOUT_N=4
ROLLOUT_BACKEND=vllm
ROLLOUT_TP_SIZE=4
ROLLOUT_GPU_MEMORY_UTILIZATION=0.50
ROLLOUT_MAX_MODEL_LEN=65536
ROLLOUT_ENFORCE_EAGER=False
VLLM_DISABLE_CUSTOM_ALL_REDUCE=True
MAX_PROMPT_LENGTH=10240
MAX_RESPONSE_LENGTH=10240
MAX_ASSISTANT_TURNS=12
ULYSSES_SEQUENCE_PARALLEL_SIZE=4
ACTOR_LR=5e-7
KL_LOSS_COEF=0.006
ACTOR_PARAM_OFFLOAD=True
ACTOR_OPTIMIZER_OFFLOAD=True
CRITIC_OFFLOAD_POLICY=True
CRITIC_OPTIMIZER_FOREACH=False

# LoRA; use LORA_RANK=0 for full-parameter training.
LORA_RANK=32
LORA_ALPHA=64
LORA_TARGET_MODULES=all-linear
LORA_EXCLUDE_MODULES=.*visual.*

# GRPB
CRAYOTTER_RL_PROCESS_REWARD=1
CRAYOTTER_RL_PREFERENCE_VARIANT=grpb
CRAYOTTER_RL_SEGMENT_ALLOCATOR_ENABLED=1
CRAYOTTER_RL_ALLOCATOR_UPDATE_ENABLED=1
CRAYOTTER_RL_SEGMENT_ALLOCATOR_STATE=/path/to/output/segment_allocator.json
CRAYOTTER_RL_TRAINING_METRICS_JSONL=/path/to/output/training_metrics.jsonl

# Optional OpenAI-compatible final-video judge. Never store its key here.
CRAYOTTER_RL_JUDGE_ENABLED=false
CRAYOTTER_RL_JUDGE_BASE_URL=https://api.example.com/v1
CRAYOTTER_RL_JUDGE_MODEL=judge-model
